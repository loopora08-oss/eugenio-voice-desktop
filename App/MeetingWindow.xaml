<Window x:Class="VoceLocale.MeetingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eugenio Notetaker" Width="1180" Height="800" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#101820" Foreground="#E8EEF6" FontFamily="Segoe UI" PreviewKeyDown="MeetingKeyDown">
  <Window.Resources>
    <Style x:Key="NoteBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="#17232C"/><Setter Property="Foreground" Value="#E8EEF6"/><Setter Property="CaretBrush" Value="#D6F1E4"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NewButton" Content="Nuovo" Click="NewDocument"/><Button Content="Apri appunti" Click="OpenDocument"/><Button Content="Salva" Click="SaveDocument"/></StackPanel>
      <StackPanel><TextBlock Text="Eugenio Notetaker" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Meeting, trascrizione live e appunti sul tuo PC" Foreground="#A8B7C5" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#1C2A34" CornerRadius="14" Padding="18" Margin="0,0,0,18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TimerLabel" Text="00:00:00" FontSize="25" FontWeight="SemiBold" Margin="0,0,20,0"/><Button x:Name="StartButton" Content="● Avvia meeting" Click="StartMeeting"/><Button x:Name="PauseButton" Content="Pausa" Click="PauseMeeting" IsEnabled="False"/><Button x:Name="StopButton" Content="Termina" Click="StopMeeting" IsEnabled="False"/></StackPanel>
          <StackPanel><TextBox x:Name="TitleBox" Text="Meeting Eugenio" FontSize="18" Background="#1C2A34" Foreground="#E8EEF6" Padding="0" Margin="0,0,15,8"/><TextBlock x:Name="StateLabel" Text="Pronto · il microfono è spento" Foreground="#9CDEBE"/></StackPanel>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
          <ComboBox x:Name="MicrophoneBox" MinWidth="280" MaxWidth="340" Margin="0,0,16,0" AutomationProperties.Name="Microfono meeting"/>
          <ComboBox x:Name="SpeechProfileBox" MinWidth="195" Margin="0,0,16,0" AutomationProperties.Name="Qualità trascrizione meeting"><ComboBoxItem Content="Equilibrata" Tag="adaptive"/><ComboBoxItem Content="Massima velocità" Tag="speed"/><ComboBoxItem Content="Precisione" Tag="accurate"/></ComboBox>
          <ComboBox x:Name="MeetingLanguageBox" MinWidth="145" Margin="0,0,16,0" AutomationProperties.Name="Lingua meeting"><ComboBoxItem Content="Italiano / English" Tag="auto"/><ComboBoxItem Content="Italiano" Tag="it"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
          <CheckBox x:Name="SystemAudioBox" Content="Acquisisci anche audio PC" Foreground="{StaticResource Ink}" Margin="{StaticResource ControlGap}" AutomationProperties.Name="Acquisisci audio PC dall'uscita predefinita"/>
          <CheckBox x:Name="TranslationBox" MinWidth="160" ToolTip="Traduzione letterale: conserva negazioni, cifre e ripensamenti." Foreground="#E8EEF6" VerticalAlignment="Center" Margin="0,0,18,0" AutomationProperties.Name="Traduci in inglese"><TextBlock Text="Traduci in inglese" TextWrapping="NoWrap" TextTrimming="None"/></CheckBox>
          <CheckBox x:Name="AutomaticNotesBox" Content="Riepilogo automatico" IsChecked="True" Foreground="#E8EEF6" VerticalAlignment="Center"/>
          <ProgressBar x:Name="MicrophoneLevel" Width="70" Height="5" Minimum="0" Maximum="1" Margin="18,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="LevelLabel" Text="Microfono spento" FontSize="12" VerticalAlignment="Center" Foreground="#A8B7C5"/>
        </WrapPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Text="0 blocchi" Foreground="#A8B7C5"/><TextBlock Text="Trascrizione live" FontSize="18" FontWeight="SemiBold"/></DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
          <TextBlock Text="Cerca nella trascrizione" Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,0,0,4"/>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="SearchPreviousButton" Content="Prec." Padding="8,5" Margin="4,0,0,0" Click="SearchPrevious" IsEnabled="False" AutomationProperties.Name="Blocco corrispondente precedente" ToolTip="Risultato precedente · Maiusc+Invio"/>
              <Button x:Name="SearchNextButton" Content="Succ." Padding="8,5" Margin="4,0,0,0" Click="SearchNext" IsEnabled="False" AutomationProperties.Name="Blocco corrispondente successivo" ToolTip="Risultato successivo · Invio"/>
              <Button x:Name="SearchClearButton" Content="×" Padding="8,5" Margin="4,0,0,0" Click="ClearSearch" IsEnabled="False" AutomationProperties.Name="Cancella ricerca" ToolTip="Cancella ricerca · Esc"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" MaxLength="200" Padding="8,5" MinWidth="80" TextChanged="SearchChanged" KeyDown="SearchKeyDown" AutomationProperties.Name="Cerca nell'originale e nella traduzione" ToolTip="Ricerca locale, senza distinzione di maiuscole o accenti · Ctrl+F"/>
          </DockPanel>
          <TextBlock x:Name="SearchStatus" Text="Nessuna trascrizione da cercare." Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ListBox x:Name="TranscriptList" Grid.Row="2" Background="#101820" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Blocchi della trascrizione">
          <ListBox.ItemTemplate><DataTemplate><Border Background="#17232C" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderThickness="2">
            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource TranscriptSelection}"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#80D8B1" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Original, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#E8EEF6" BorderThickness="0" Padding="0" FontSize="15"/>
            <TextBlock Text="{Binding English}" TextWrapping="Wrap" Foreground="#A6C7F2" FontSize="14" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="#FFC58A" FontSize="12" Margin="0,5,0,0"/>
          </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="La trascrizione apparirà qui. Conferma il consenso, scegli le sorgenti e avvia il meeting." Foreground="{StaticResource SecondaryInk}" IsHitTestVisible="False" VerticalAlignment="Top">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=TranscriptList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><Button x:Name="NotesButton" DockPanel.Dock="Right" Content="Genera riepilogo" Click="GenerateNotes" Padding="10,4" Margin="0"/><TextBlock Text="Appunti" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TabControl x:Name="NotesTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
          <TabItem Header="Personali"><TextBox x:Name="NotesBox" Style="{StaticResource NoteBox}" FontSize="15" AutomationProperties.Name="Appunti personali del meeting"/></TabItem>
          <TabItem Header="Riepilogo IA"><TextBox x:Name="SummaryBox" Style="{StaticResource NoteBox}" FontSize="15" AutomationProperties.Name="Riepilogo IA del meeting"/></TabItem>
        </TabControl>
        <TextBlock x:Name="NotesHint" Grid.Row="2" Text="Scrivi gli appunti personali. L’IA riassume trascrizione e appunti in una scheda separata." Foreground="#A8B7C5" FontSize="12" Margin="0,10,0,0"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="3">
      <CheckBox x:Name="RecordingConsentBox" Content="Ho informato i partecipanti e ottenuto il consenso alla registrazione." Foreground="{StaticResource Ink}" AutomationProperties.Name="Conferma consenso dei partecipanti"/>
      <TextBlock Text="Trascrizione e appunti tramite IA locale: verifica il testo. Audio PC dall'uscita predefinita; usa cuffie per evitare eco. I parlanti remoti non sono ancora identificati." Foreground="{StaticResource SecondaryInk}" FontSize="12"/>
      <TextBlock x:Name="FooterLabel" Text="Nessun limite di un’ora · audio in memoria · contenuti salvati solo con Salva · nessun inserimento in altre app" Foreground="{StaticResource SecondaryInk}" FontSize="12"/>
    </StackPanel>
  </Grid>
</Window>
