<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:VoceLocale" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VoceLocale.MeetingWindow" Title="Eugenio Notetaker" Width="1180" Height="840" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{StaticResource Ground}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="MeetingKeyDown">
  <Window.Resources>
    <Style x:Key="NoteBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{StaticResource Ground}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="284" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <local:PixelGenieFrame LampAnchor="{Binding Lamp, ElementName=MeetingSidebar}" Grid.ColumnSpan="2" />
    <Grid Margin="20,52,56,48" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="NewButton" Content="Nuovo" Click="NewDocument" />
          <Button Content="Apri" Click="OpenDocument" />
          <Button Content="Salva appunti" Click="SaveDocument" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
        <StackPanel>
          <TextBox x:Name="TitleBox" Text="Nuovi appunti" FontSize="36" Background="Transparent" Foreground="{StaticResource Ink}" Padding="0" Margin="0,0,12,4" FontFamily="Georgia" AutomationProperties.Name="Titolo degli appunti" BorderThickness="0" MinWidth="0" />
          <TextBlock x:Name="DocumentDate" Foreground="{StaticResource SecondaryInk}" FontSize="13" />
        </StackPanel>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,12">
        <TextBlock x:Name="StateLabel" Text="Pronto · il microfono è spento" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,0,0,4" />
        <TextBlock Text="Appunti e trascrizione tramite IA locale · controlla nomi, cifre e decisioni." Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,0,0,4" />
      </StackPanel>
      <TabControl x:Name="NotesTabs" Grid.Row="2" SelectedIndex="1" Background="Transparent" BorderThickness="0">
        <TabItem Header="Appunti">
          <Grid Margin="0,20,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Annota quello che conta. Il riepilogo userà anche questi appunti." Foreground="{StaticResource SecondaryInk}" Margin="0,0,0,12" />
            <Border Grid.Row="1" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="2">
              <TextBox x:Name="NotesBox" Style="{StaticResource NoteBox}" FontSize="15" AutomationProperties.Name="Appunti personali del meeting" Padding="16" />
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Trascrizione">
          <Grid Margin="0,20,0,0">
            <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Background="{StaticResource Ground}" Padding="20" CornerRadius="2">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                  <Button DockPanel.Dock="Right" Content="Cerca  Ctrl+F" Click="ShowTranscriptSearch" Padding="10,6" Margin="0" />
                  <TextBlock x:Name="TimerLabel" Text="00:00:00" FontSize="14" FontWeight="SemiBold" Margin="0,0,16,0" Foreground="{StaticResource SecondaryInk}" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10" x:Name="SearchPanel" Visibility="Collapsed">
                  <TextBlock Text="Cerca nella trascrizione" Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,0,0,4" />
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button x:Name="SearchPreviousButton" Content="Prec." Padding="8,5" Margin="4,0,0,0" Click="SearchPrevious" IsEnabled="False" AutomationProperties.Name="Blocco corrispondente precedente" ToolTip="Risultato precedente · Maiusc+Invio" />
                      <Button x:Name="SearchNextButton" Content="Succ." Padding="8,5" Margin="4,0,0,0" Click="SearchNext" IsEnabled="False" AutomationProperties.Name="Blocco corrispondente successivo" ToolTip="Risultato successivo · Invio" />
                      <Button x:Name="SearchClearButton" Content="×" Padding="8,5" Margin="4,0,0,0" Click="ClearSearch" IsEnabled="False" AutomationProperties.Name="Cancella ricerca" ToolTip="Cancella ricerca · Esc" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox" MaxLength="200" Padding="8,5" MinWidth="80" TextChanged="SearchChanged" KeyDown="SearchKeyDown" AutomationProperties.Name="Cerca nell'originale e nella traduzione" ToolTip="Ricerca locale, senza distinzione di maiuscole o accenti · Ctrl+F" />
                  </DockPanel>
                  <TextBlock x:Name="SearchStatus" Text="Nessuna trascrizione da cercare." Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ListBox x:Name="TranscriptList" Grid.Row="2" Background="{StaticResource Ground}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Blocchi della trascrizione">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Ground}" CornerRadius="2" Padding="14" Margin="0,0,0,10" BorderThickness="2">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TranscriptSelection}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,5" />
                          <TextBox Text="{Binding Original, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" Padding="0" FontSize="16" />
                          <TextBlock Text="{Binding English}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryInk}" FontSize="14" Margin="0,8,0,0" />
                          <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{StaticResource WarningInk}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="La trascrizione apparirà qui.&#10;Scegli le sorgenti e avvia il meeting." Foreground="{StaticResource SecondaryInk}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" FontSize="16" Margin="24" LineHeight="26">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count, ElementName=TranscriptList}" Value="0">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Riepilogo IA">
          <Grid Margin="0,20,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right">
                <Button x:Name="NotesButton" DockPanel.Dock="Right" Content="Genera riepilogo" Click="GenerateNotes" Padding="14,8" Margin="0,0,0,0" />
              </StackPanel>
              <TextBlock Text="Da appunti e trascrizione" Foreground="{StaticResource SecondaryInk}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="2">
              <TextBox x:Name="SummaryBox" Style="{StaticResource NoteBox}" FontSize="15" AutomationProperties.Name="Riepilogo IA del meeting" Padding="16" />
            </Border>
            <TextBlock Grid.Row="2" x:Name="NotesHint" Text="Scrivi gli appunti personali. L’IA riassume trascrizione e appunti in una scheda separata." Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,10,0,0" />
          </Grid>
        </TabItem>
      </TabControl>
      <Expander Grid.Row="3" Header="Sorgenti audio e opzioni" Foreground="{StaticResource SecondaryInk}" Margin="0,16,0,0">
        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
          <WrapPanel Margin="0,12,0,0">
            <ComboBox x:Name="MicrophoneBox" MinWidth="220" MaxWidth="280" Margin="0,0,16,12" AutomationProperties.Name="Microfono meeting" />
            <ComboBox x:Name="SpeechProfileBox" MinWidth="195" Margin="0,0,16,12" AutomationProperties.Name="Qualità trascrizione meeting">
              <ComboBoxItem Content="Equilibrata" Tag="adaptive" />
              <ComboBoxItem Content="Massima velocità" Tag="speed" />
              <ComboBoxItem Content="Precisione" Tag="accurate" />
            </ComboBox>
            <ComboBox x:Name="MeetingLanguageBox" MinWidth="145" Margin="0,0,16,12" AutomationProperties.Name="Lingua meeting">
              <ComboBoxItem Content="Italiano / English" Tag="auto" />
              <ComboBoxItem Content="Italiano" Tag="it" />
              <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <CheckBox x:Name="SystemAudioBox" Content="Acquisisci anche audio PC" Foreground="{StaticResource Ink}" Margin="0,0,16,12" AutomationProperties.Name="Acquisisci audio PC dall'uscita predefinita" />
            <CheckBox x:Name="TranslationBox" MinWidth="160" ToolTip="Traduzione letterale: conserva negazioni, cifre e ripensamenti." Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,12" AutomationProperties.Name="Traduci in inglese">
              <TextBlock Text="Traduci in inglese" TextWrapping="NoWrap" TextTrimming="None" />
            </CheckBox>
            <CheckBox x:Name="AutomaticNotesBox" Content="Riepilogo automatico" IsChecked="True" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,12" />
          </WrapPanel>
        </ScrollViewer>
      </Expander>
      <StackPanel Grid.Row="4">
        <CheckBox x:Name="RecordingConsentBox" Foreground="{StaticResource Ink}" AutomationProperties.Name="Conferma consenso dei partecipanti" Margin="0,12,0,8">
          <TextBlock Text="Ho informato i partecipanti e ottenuto il consenso." TextWrapping="Wrap" FontSize="12" />
        </CheckBox>
        <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
          <WrapPanel VerticalAlignment="Center">
            <Button x:Name="StartButton" Content="Avvia meeting" Click="StartMeeting" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="PauseButton" Content="Pausa" Click="PauseMeeting" IsEnabled="False" />
            <Button x:Name="StopButton" Content="Termina" Click="StopMeeting" IsEnabled="False" />
            <ProgressBar x:Name="MicrophoneLevel" Width="70" Height="5" Minimum="0" Maximum="1" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="LevelLabel" Text="Microfono spento" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SecondaryInk}" />
          </WrapPanel>
        </Border>
        <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Text="0 blocchi" Foreground="{StaticResource SecondaryInk}" />
        <TextBlock x:Name="FooterLabel" Text="Audio in memoria · salva esplicitamente per conservare appunti e trascrizione." Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>
    <local:EugenioSidebar x:Name="MeetingSidebar" Margin="56,52,24,48" SelectedPage="meeting" />
  </Grid>
</Window>