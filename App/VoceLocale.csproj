<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VoceLocale</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/VoceLocale.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="assets/EugenioMascot.png" />
  </ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
</Project>
