<Application x:Class="VoceLocale.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#E8EEF6" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="Background" Value="#101820" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Background" Value="#D6F1E4" /><Setter Property="Foreground" Value="#12241D" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,5,0,14" /><Setter Property="MinHeight" Value="36" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10" /><Setter Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="#15202B" /><Setter Property="BorderThickness" Value="0" /></Style>
  </Application.Resources>
</Application>
